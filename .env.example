DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=digitallibrary
POSTGRES_USER=digitallibrary
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://digitallibrary:replace-with-a-local-password@db:5432/digitallibrary
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=replace-with-local-minio-username
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=library-media
MINIO_USE_SSL=False
FRONTEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost/api
