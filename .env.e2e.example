# ============================================================
# E2E environment template
# Copy to .env.e2e and replace every change-me placeholder.
# This file is safe to commit. NEVER commit .env or .env.e2e.
# ============================================================

# PostgreSQL (e2e-db)
E2E_POSTGRES_DB=change-me
E2E_POSTGRES_USER=change-me
E2E_POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://change-me:change-me@e2e-db:5432/change-me

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,e2e-backend
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0

# Redis
REDIS_URL=redis://e2e-redis:6379/0

# MinIO
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=e2e-minio:9000
MINIO_BUCKET=e2e-library-media
MINIO_USE_SSL=False

# Cross-origin / frontend
CORS_ALLOWED_ORIGINS=http://localhost:18081
FRONTEND_URL=http://localhost:18081

# Seed accounts (e2e only — throwaway credentials, not real secrets)
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=change-me
E2E_SUPERUSER_USERNAME=superuser
E2E_SUPERUSER_EMAIL=superuser@example.com
E2E_SUPERUSER_PASSWORD=change-me
E2E_MINIO_ROOT_USER=change-me
E2E_MINIO_ROOT_PASSWORD=change-me
E2E_TEST_USER_PASSWORD=change-me
